# Read by scripts/check-noir.sh. Round circuits (bin packages under this
# directory) in round order, then the libraries whose tests it runs.
#
# pss_seed is examples/amm's seed round, reached through the link
# pss_seed -> ../../amm/circuits/pss_seed, as examples/amm reaches
# amm_swap_total: one package and one vk, registered here under this
# example's manifest. Its Prover case is examples/amm's, and that
# example's outputs.txt checks it.
CIRCUITS="pss_seed monty_hall_init monty_hall_open_door monty_hall_finish"
LIBS="monty_hall"
