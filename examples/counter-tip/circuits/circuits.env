# Read by scripts/check-noir.sh. Round circuits (bin packages under this
# directory) in round order, then the libraries whose tests it runs.
CIRCUITS="counter_init counter_add"
LIBS="counter_tip"
# The total circuits, linted by total-lint: both rounds (neither asserts).
# counter_add calls only total-noir entries whose hints co-noir runs
# (add_or through counter_tip), as the network extends its witness in
# co-noir; check-noir runs total-lint --brillig-ops on every circuit.
TOTAL_CIRCUITS="counter_init counter_add"
# No extra --lib-src (TOTAL_LIB_SRC): counter_tip adds no hint of its own.
