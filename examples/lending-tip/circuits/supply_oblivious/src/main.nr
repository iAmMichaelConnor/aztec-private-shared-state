//! Generated by scripts/gen-access.py from ../supply_shared/src/main.nr; do not edit
//! (`python3 -I scripts/gen-access.py lending-tip supply_shared` rewrites it, `--check` compares).
//! `supply_shared` over the oblivious book (`access: oblivious`, manifests/supply_oblivious.json;
//! docs/ARCHITECTURE.md section 6, "The oblivious tree"): the same round of the app library with the
//! indices composed in the circuit from the request's positions, which are
//! shared too, the slots read from the nodes' oblivious RAM and no leaf hash
//! out. The request also takes the public opening flag `opens`.
//! The public inputs are the clear round's.

use lending_tip::entry::{self, Opening, Pinned, Prefix, Shared, SharedIntake, Slots};
use lending_tip::market::{DEPTH, Leaf, OWNER_SLOTS};

fn main(
    // ---- the public prefix (entry::Prefix) and the pinned reads (entry::Pinned) ----
    namespace: pub Field,
    vk_hash: pub Field,
    in_slots: pub [Field; 1],
    out_slots: pub [Field; 1],
    // the pinned epoch read: the oracle's price and its epoch
    price: pub Field,
    price_epoch: pub Field,
    // the pinned clock read: the market's clock(), within CLOCK_BAND blocks
    clock: pub Field,
    // ---- the secret-shared intake: C, then the values it commits to, in C's order ----
    // C, PUBLIC $inputs_hash
    inputs_hash: Field,
    // the lender position's index; 0 opens a new one
    position: Field,
    // 1 when the request opens a position
    opens: Field,
    // the amount supplied
    amount: Field,
    // the user's partial note, completed with the outcome
    partial_note: Field,
    outcome_key: Field,
    outcome_tag: Field,
    blinding: Field,
    // ---- the book's slots, the nodes' oblivious RAM reads ----
    leaves: [Leaf; OWNER_SLOTS],
    old_hashes: [Field; OWNER_SLOTS],
    siblings: [[Field; DEPTH]; OWNER_SLOTS],
    // the append index the scheduler assigns ($new_leaf), 0 when the book is full
    new_leaf: Field,
    // ---- the new blindings, SAMPLE 2 ----
    r_new: [Field; OWNER_SLOTS],
    // the fixed LOAD, for npk_app_hash
    nsk_app: Field,
) -> pub Shared<OWNER_SLOTS> {
    entry::supply(
        Opening { opens, shared: SharedIntake { inputs_hash, partial: partial_note, outcome_key, outcome_tag, blinding }, handle: Option::none() },
        Prefix { namespace, vk_hash, in_slots, out_slots },
        Pinned { price, price_epoch, clock },
        [position, amount],
        Slots { leaves, old_hashes, siblings },
        new_leaf,
        r_new,
        nsk_app,
    )
}
