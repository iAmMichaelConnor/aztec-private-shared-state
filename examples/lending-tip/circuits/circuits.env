# Read by scripts/check-noir.sh. Round circuits (bin packages under this
# directory) in round order, then the libraries whose tests it runs.
CIRCUITS="lending_init deposit deposit_shared withdraw_shared borrow_shared repay_shared supply_shared withdraw_supply_shared view_shared quote_shared liquidate_shared scan_shared lending_init_oblivious deposit_oblivious supply_oblivious borrow_oblivious withdraw_oblivious repay_oblivious withdraw_supply_oblivious view_oblivious liquidate_oblivious quote_oblivious scan_oblivious"
LIBS="lending_tip"
# The total circuits, linted by total-lint: every lending circuit, the
# init and the queued rounds: the non-secret-shared deposit and the secret-shared rounds. The
# init is never queued (the operator's deployment runs it once) and keeps
# one assert (liquidity is a u128), justified by its marker in its main.nr.
TOTAL_CIRCUITS="lending_init deposit deposit_shared withdraw_shared borrow_shared repay_shared supply_shared withdraw_supply_shared view_shared quote_shared liquidate_shared scan_shared lending_init_oblivious deposit_oblivious supply_oblivious borrow_oblivious withdraw_oblivious repay_oblivious withdraw_supply_oblivious view_oblivious liquidate_oblivious quote_oblivious scan_oblivious"
# co-noir entries: the rounds call only total-noir entries whose hints co-noir
# runs (clamp_bits_or, fits_bits, to_u128_or, TotalArith's u128 add_or and
# sub_or, mul_div_wide_to_or; total-noir's page "co-noir compatibility of the
# library's hints"), because the network extends their witnesses in co-noir,
# whose Brillig VM at the pinned co-snarks rev has no integer shift, mask or
# ConditionalMov and no black box but ToRadix. check-noir's lint runs
# total-lint --brillig-ops on each round (0 unsupported ops) but does not run
# co-noir: after a change, run a co-noir witness extension
# (scripts/witness-extend.sh runs it). Required inside the co-SNARK.
# No extra --lib-src (TOTAL_LIB_SRC): lending_tip adds no hint of its own and
# calls only total entries, whose hints total's src whitelists; the reported
# items are pss_core's (tree::load's old-leaf check, the index bit splits, the
# std scalar decomposition in npk_app_hash), justified by pss_core's markers
# (scripts/check-noir.sh counts them).
