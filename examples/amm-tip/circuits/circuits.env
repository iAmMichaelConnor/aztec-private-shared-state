# Read by scripts/check-noir.sh. Round circuits (bin packages under this
# directory) in round order, then the libraries whose tests it runs.
CIRCUITS="amm_init_tip amm_swap_tip amm_swap_tip_shared amm_swap_tip_next"
LIBS="amm_tip"
# The total circuits, linted by total-lint: the queued swap
# round's two entries (one circuit for on-chain intake and receipt intake,
# one for secret-shared receipt intake). amm_init_tip is left out: it is never
# queued, its inputs are sampled by the network for the operator's
# deployment, and it keeps examples/amm's Pool::from_seed (native u64
# arithmetic the lint reports); its main.nr says why.
TOTAL_CIRCUITS="amm_swap_tip amm_swap_tip_shared amm_swap_tip_next"
# Co-noir entries: the total circuits above call only total-noir entries whose
# hints co-noir runs (to_u64_or, add_or, mul_div_or through amm_total;
# total-noir's page "co-noir compatibility of the library's hints"), because
# the network extends their witnesses in co-noir, whose Brillig VM at the
# pinned co-snarks rev has no integer shift, mask or ConditionalMov.
# check-noir runs total-lint --brillig-ops on every circuit in CIRCUITS and
# fails on any unsupported op, but it does not run co-noir: after a change,
# also run scripts/witness-extend.sh examples/amm-tip (a three-party co-noir
# witness extension of every Prover case). Required inside the co-SNARK.
# No extra --lib-src (TOTAL_LIB_SRC): amm_tip and amm_total add no hint of
# their own and call only total entries, whose hints total's src whitelists;
# the only reported items are std's (the scalar decomposition in pss_core's
# npk_app_hash), justified by pss_core's markers (scripts/check-noir.sh counts
# them). Listing amm_total/src/ or amm_tip/src/ would whitelist hints
# unreviewed; they have none.
