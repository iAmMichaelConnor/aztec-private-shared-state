//! Generated by scripts/gen-intake.py from the example's manifests; do not edit
//! (`python3 -I scripts/gen-intake.py --layouts` rewrites it, `--check` compares).
//! One global per round under a secret-shared intake: the kind of each value of
//! the inputs commitment C in C's order, CHOSEN for an INPUT_SHARED value and
//! CLEAR for any other, which the round's request function hands
//! `outcome_request`. A layout the machine does not derive gives shares that
//! miss C (secret-shared on-chain intake) or receipts that do not verify
//! (secret-shared receipt intake).
use pss_public_contract::{CHOSEN, Layout};

/// manifests/claim.json: `[key, amount, $partial_note, $outcome_key, $outcome_tag]`.
pub global CLAIM_LAYOUT: Layout<5, 0, 5> =
    Layout { kinds: [CHOSEN, CHOSEN, CHOSEN, CHOSEN, CHOSEN] };

/// manifests/move.json: `[from, to, amount, $partial_note, $outcome_key, $outcome_tag]`.
pub global MOVE_LAYOUT: Layout<6, 0, 6> =
    Layout { kinds: [CHOSEN, CHOSEN, CHOSEN, CHOSEN, CHOSEN, CHOSEN] };

/// manifests/pay.json: `[key, amount, $partial_note, $outcome_key, $outcome_tag]`.
pub global PAY_LAYOUT: Layout<5, 0, 5> =
    Layout { kinds: [CHOSEN, CHOSEN, CHOSEN, CHOSEN, CHOSEN] };

/// manifests/view.json: `[key, $partial_note, $outcome_key, $outcome_tag]`.
pub global VIEW_LAYOUT: Layout<4, 0, 4> =
    Layout { kinds: [CHOSEN, CHOSEN, CHOSEN, CHOSEN] };
