# Read by scripts/check-noir.sh. Round circuits (bin packages under this
# directory) in round order, then the libraries whose tests it runs.
CIRCUITS="credits_init pay claim view move"
LIBS="credits_tip"
# Every queued round is total: a request that cannot apply still proves and
# lands as a flagged no-op. credits_init is never queued (the operator's
# deployment) and is total too.
TOTAL_CIRCUITS="credits_init pay claim view move"
# No extra --lib-src (TOTAL_LIB_SRC): credits_tip adds no hint of its own and calls only
# total and pss_core entries; the reported items are pss_core's (the
# map's key bit split, tree::load's old-leaf check, the std scalar
# decomposition in npk_app_hash), justified by pss_core's markers (scripts/check-noir.sh counts them).
