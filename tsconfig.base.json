// The compiler options of every TypeScript package (pss-client, pss-relayer,
// test-support, e2e, the counter-tip example's client) and of the chain
// reader's live-network scripts (machine/sidecar-tip/tests/chain).
// Resolution rule: an emitting build (tsconfig.json of pss-client and
// pss-relayer) reads a sibling package's dist/ types; every type check of
// tests or of code run from source adds `customConditions: ["source"]`, as
// every node command that runs it passes --conditions=source.
{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  }
}
