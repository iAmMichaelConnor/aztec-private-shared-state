//! Aztec note hashing and nullification for circuits that run outside
//! aztec-nr: the standalone co-SNARK round circuits.
//!
//! aztec-nr computes these hashes only inside contract machinery (a
//! `#[note]` type, a `PrivateContext`, PXE oracles for randomness and
//! kernel key-validation requests for nullifier keys). A round circuit
//! has none of these: the verifying contract talks to the kernel, the
//! circuit only proves hashes, and the randomness and the nullifier key
//! are secret-shared inputs held by the MPC nodes.
//!
//! So this module holds the pure formulas, one function each. Where the
//! `protocol_types` crate (Aztec v6.0.0) exports a composition, it is
//! used directly, so the values equal aztec-nr's by construction. The
//! inner note hash and the note nullifier have no importable home (they
//! are generated by aztec-nr macros), so `note_hash` and `note_nullifier`
//! restate them, pinned by known-answer tests.
//!
//! Division of work in one call:
//! - the round circuit proves note preimages (hash recomputation) and
//!   nullifier correctness under the namespace's nsk_app;
//! - the protocol kernel proves note-hash existence in the tree, via the
//!   read requests the contract pushes;
//! - the contract binds the two by feeding what it read and pushed into
//!   the proof's public inputs.

use protocol_types::address::aztec_address::AztecAddress;
use protocol_types::constants::{DOM_SEP__NOTE_HASH, DOM_SEP__NOTE_NULLIFIER};
use protocol_types::hash::{
    compute_siloed_note_hash, compute_unique_note_hash, poseidon2_hash_with_separator,
};
use protocol_types::traits::FromField;
use std::embedded_curve_ops::{EmbeddedCurveScalar, fixed_base_scalar_mul};

/// Domain separator of npk_app_hash, ASCII "sidecar.npk_app". A machine
/// constant, not an Aztec one: the nodes compute the same hash at the
/// namespace's first REGISTER, and the contract is the only verifier of
/// the nullifiers it guards.
pub global SIDECAR_NPK_APP: Field = 0x736964656361722e6e706b5f617070;

/// ASCII "sidecar.nsk_app": the domain separator under which the nodes
/// derive nsk_app from their master secret and the namespace at a
/// namespace's first REGISTER. No circuit here receives the master secret;
/// tests and the vector programs check the derivation with it.
pub global SIDECAR_NSK_APP: Field = 0x736964656361722e6e736b5f617070;

/// The inner note hash of a canonical `#[note]` note:
/// `P2(DOM_SEP__NOTE_HASH, storage_slot, packed_note..., owner, randomness)`.
///
/// Restates aztec-nr's `#[note]` derive (note/utils.nr compute_note_hash).
/// This is the value the contract pushes (`push_note_hash`); the kernel
/// silos and uniquifies it.
///
/// storage_slot and owner are public (the contract feeds them into the
/// proof's public inputs); randomness stays secret-shared.
pub fn note_hash<let N: u32>(
    storage_slot: Field,
    owner: Field,
    packed_note: [Field; N],
    randomness: Field,
) -> Field {
    let data = packed_note.concat([owner, randomness]);
    poseidon2_hash_with_separator([storage_slot].concat(data), DOM_SEP__NOTE_HASH)
}

/// The unique note hash of a settled note, its note-hash-tree leaf:
/// `compute_unique_note_hash(note_nonce, compute_siloed_note_hash(
/// contract_address, note_hash))`.
///
/// `note_nonce` is the protocol nonce the kernel derived from the
/// creating tx's first nullifier and the note's index in that tx. It is a
/// self-verifying hint: a wrong nonce gives a leaf that is not in the
/// tree, and the contract's read request fails.
///
/// For a settled note this leaf is also the `note_hash_for_nullification`
/// of the canonical nullifier.
pub fn unique_note_hash(contract_address: Field, note_hash: Field, note_nonce: Field) -> Field {
    let siloed_note_hash =
        compute_siloed_note_hash(AztecAddress::from_field(contract_address), note_hash);
    compute_unique_note_hash(note_nonce, siloed_note_hash)
}

/// The note nullifier:
/// `P2(DOM_SEP__NOTE_NULLIFIER, note_hash_for_nullification, nsk_app)`.
///
/// The formula of aztec-nr note/utils.nr compute_note_nullifier, with the
/// namespace's nsk_app in the place of the protocol's nhk_app. The kernel
/// silos the result by the emitting contract's address.
pub fn note_nullifier(note_hash_for_nullification: Field, nsk_app: Field) -> Field {
    poseidon2_hash_with_separator(
        [note_hash_for_nullification, nsk_app],
        DOM_SEP__NOTE_NULLIFIER,
    )
}

/// The network's nullifying identity for one namespace:
/// `P2(SIDECAR_NPK_APP, (nsk_app · G).x, (nsk_app · G).y)`, G the
/// Grumpkin generator. One fixed-base multiplication.
///
/// Every Field is a valid Grumpkin scalar (the BN254 scalar field is
/// smaller than Grumpkin's), so `from_field` loses nothing.
pub fn npk_app_hash(nsk_app: Field) -> Field {
    // total-lint: allow std's EmbeddedCurveScalar::from_field decomposition and the fixed-base multi_scalar_mul on the generator, reviewed hint-satisfiable for every Field
    let npk_app = fixed_base_scalar_mul(EmbeddedCurveScalar::from_field(nsk_app));
    poseidon2_hash_with_separator([npk_app.x, npk_app.y], SIDECAR_NPK_APP)
}

mod tests {
    use super::{note_hash, note_nullifier, npk_app_hash, SIDECAR_NSK_APP, unique_note_hash};
    use protocol_types::hash::{compute_note_hash_nonce, poseidon2_hash_with_separator};

    global SLOT: Field = 3;
    global OWNER: Field = 0x1122;
    global RAND: Field = 0x99;
    global NSK_APP: Field = 0x234500000000000000000000000000001234;

    // Known-answer tests pinning chain-visible values. Regenerate only on
    // a deliberate change of the Aztec protocol pin or of SIDECAR_NPK_APP.
    #[test]
    fn kat_note_hash_and_nullifier() {
        let nh = note_hash(SLOT, OWNER, [0x42], RAND);
        let leaf = unique_note_hash(0xc0, nh, compute_note_hash_nonce(7, 0));
        assert_eq(nh, 0x0a5e5fc7c279bc18cf34d40b89e636624ddca8c51bc9a009405b4ae33a5ab71a);
        assert_eq(note_nullifier(leaf, NSK_APP), KAT_NULLIFIER);
        assert_eq(npk_app_hash(NSK_APP), KAT_NPK_APP_HASH);
    }

    // The derivation the nodes run at REGISTER, with a dealer-known
    // master and namespace, so the machine's own implementation can be
    // checked against these two values.
    #[test]
    fn kat_register_derivation() {
        let master = 0x6d6173746572;
        let namespace = 0xc0ffee;
        let nsk_app = poseidon2_hash_with_separator([master, namespace], SIDECAR_NSK_APP);
        assert_eq(nsk_app, KAT_DERIVED_NSK_APP);
        assert_eq(npk_app_hash(nsk_app), KAT_DERIVED_NPK_APP_HASH);
    }

    global KAT_NULLIFIER: Field =
        0x02906c7cf8b4c755f1a59dfce35b50195ea64a3e2251788b6e051185361a0b19;
    global KAT_NPK_APP_HASH: Field =
        0x144c11a9981296c70b436cc3adb6e32b387a4b9072d6e0509fd86938dfce2529;
    global KAT_DERIVED_NSK_APP: Field =
        0x02ae8d3b9b6a6b6e9e5b20349f68cedb428409d2884aa23c0d98bf4d13e04eda;
    global KAT_DERIVED_NPK_APP_HASH: Field =
        0x1f21c078530872675c230b247bed26ffce80c76ab6eeb360895ca8cbd8b92e16;
}
